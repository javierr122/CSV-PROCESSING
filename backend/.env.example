# App
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Base de datos (PostgreSQL - Docker local)
DATABASE_URL="postgresql://csv_user:csv_password@localhost:5432/document_processing?schema=public"

# Drivers: elige la implementación de storage/cola.
# s3   -> sube/descarga contra LocalStack S3 (requiere `docker compose up -d`)
# local -> guarda los archivos en ./uploads del backend (no requiere LocalStack)
STORAGE_DRIVER=s3

# sqs  -> publica/consume contra LocalStack SQS (requiere `docker compose up -d`)
# mock -> cola en memoria (no requiere LocalStack, ideal si nunca usaste SQS)
MESSAGE_QUEUE_DRIVER=sqs

# AWS / LocalStack (solo si STORAGE_DRIVER=s3 o MESSAGE_QUEUE_DRIVER=sqs)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_NAME=csv-processing-bucket
SQS_QUEUE_URL=http://localhost:4566/000000000000/file-processing-queue

# CORS
CORS_ORIGIN=http://localhost:3000

# Tamaño máximo del CSV que acepta el endpoint de subida (en MB).
# Súbelo si necesitas cargar archivos más grandes (ej: 100000 filas).
MAX_UPLOAD_SIZE_MB=100
